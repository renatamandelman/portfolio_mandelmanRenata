---
/**
 * index.astro — Página principal.
 * Arma la experiencia: llena los slots de SplitLayout con los datos de profile.ts.
 *
 * Cada panel tiene dos partes:
 *   imagen → siempre visible: trabajo real (celular con un reel, collage de diseños, captura de un sitio)
 *   .more  → los proyectos de esa área: solo al tocar Content, Design o Code
 *            (lo decide el CSS de SplitLayout según <html data-view>)
 *
 * Las marcas del lado content son <ProjectCard /> (botón + modal con videos).
 * En el panel Code, <DynamicApiWidget /> muestra los proyectos web (profile.ts + API de GitHub) en una sola lista.
 */
import SplitLayout from '../layouts/SplitLayout.astro';
import Hero from '../components/Hero.astro';
import BrowserCard from '../components/BrowserCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DynamicApiWidget from '../components/DynamicApiWidget.astro';
import { embedUrl } from '../utils/embed';
import {
  profile,
  experiences,
  stack,
  socials,
  contact,
  projects,
  designWork,
  designCategories,
  tools,
  areas,
} from '../data/profile';

// Redes sociales: solo los videos que elegí (featured en profile.ts), cada uno con su trabajo
const featuredVideos = experiences.flatMap((job) =>
  (job.videos ?? []).filter((video) => video.featured).map((video) => ({ video, job })),
);

// Portada de Diseño: 3 trabajos con imagen, el destacado (featured) primero
const designPreview = [...designWork.filter((work) => work.featured), ...designWork.filter((work) => !work.featured)]
  .filter((work) => work.image)
  .slice(0, 3);

// Portada de Programación: el sitio marcado como featured en profile.ts
const featuredSite = projects.find((project) => project.featured);

// Video del celular: se busca por id entre los videos de todas las experiencias
const heroVideo = experiences.flatMap((e) => e.videos ?? []).find((v) => v.src === profile.heroVideo);

// Abanico del hero: un trabajo de cada área (la del medio va adelante)
const heroPreviews = [
  { src: designPreview[0]?.image ?? '', alt: designPreview[0]?.title ?? '' },
  { src: featuredSite?.image ?? '', alt: `Sitio web de ${featuredSite?.title}` },
  { src: heroVideo?.poster ?? '', alt: `Video para ${heroVideo?.brand}` },
].filter((preview) => preview.src); // si falta alguna imagen, no se dibuja
---

<SplitLayout>
  <!-- ============ HERO ============ -->
  <!-- Presentación: todo sale de profile.ts. En el centro, 3 trabajos reales (uno por área) -->
  <Hero
    slot="hero"
    name={profile.name}
    role={profile.role}
    tagline={profile.tagline}
    areas={areas}
    previews={heroPreviews}
    tools={tools}
  />

  <!-- ============ PANEL CONTENT ============ -->
  <Fragment slot="content">
    <header>
      <h2
        id="pane-content-title"
        class="font-display text-2xl leading-snug font-bold tracking-tight md:text-3xl"
      >
        Redes sociales
      </h2>
      <p class="mt-2 text-sm text-muted md:text-base">Videos para que más gente conozca tu marca</p>
    </header>

    <!-- Imagen + proyectos. @container: se acomoda al ancho del PANEL.
         Panel angosto (inicio, mobile) → uno debajo del otro.
         Panel ancho (vista de esta área en desktop) → imagen a la izquierda, proyectos a la derecha -->
    <div class="@container">
      <div class="@4xl:grid @4xl:grid-cols-[minmax(0,26rem)_1fr] @4xl:items-start @4xl:gap-12">
        <!-- IMAGEN: el celular con un reel mío, centrado -->
        <div class="mx-auto my-5 w-full max-w-md">
          <!-- Celular con Reels: muestra heroVideo. El reproductor de TikTok se carga
               recién al tocar play (lo agrega el script de abajo). -->
          <div
            class="relative mx-auto aspect-[9/16] w-full max-w-[200px] overflow-hidden rounded-2xl border-2 border-surface bg-linear-to-b from-accent to-ink shadow-xl"
            data-hero-video={heroVideo && embedUrl(heroVideo, true)}
            data-hero-title={heroVideo && `${heroVideo.brand}: ${heroVideo.title}`}
          >
            {heroVideo?.poster && <img src={heroVideo.poster} alt="" class="absolute inset-0 size-full object-cover" />}
            <span aria-hidden="true" class="absolute top-2.5 left-2.5 rounded-full bg-ink/40 px-2 py-0.5 text-[9px] font-medium text-cream backdrop-blur">
              Reels
            </span>
            <!-- Acciones laterales: me gusta, comentar, compartir -->
            <div class="absolute right-2 bottom-10 flex flex-col gap-2 text-cream" aria-hidden="true">
              <span class="flex size-6 items-center justify-center rounded-full bg-surface/30 backdrop-blur-sm">
                <svg viewBox="0 0 24 24" class="size-2.5" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z" /></svg>
              </span>
              <span class="flex size-6 items-center justify-center rounded-full bg-surface/30 backdrop-blur-sm">
                <svg viewBox="0 0 24 24" class="size-2.5" fill="currentColor"><path d="M4 4h16v12H8l-4 4z" /></svg>
              </span>
              <span class="flex size-6 items-center justify-center rounded-full bg-surface/30 backdrop-blur-sm">
                <svg viewBox="0 0 24 24" class="size-2.5" fill="currentColor"><path d="M3 11l18-8-8 18-2-8z" /></svg>
              </span>
            </div>
            <div class="absolute bottom-2 left-2 rounded-lg bg-ink/40 px-2 py-0.5 text-cream backdrop-blur-sm">
              <p class="text-[9px] font-bold">{profile.name}</p>
              {heroVideo && <p class="text-[8px] opacity-80">{heroVideo.brand} · {heroVideo.title}</p>}
            </div>
            {
              heroVideo && (
                <button
                  type="button"
                  class="absolute inset-x-0 top-[30%] mx-auto flex size-11 cursor-pointer items-center justify-center rounded-full bg-surface/90 text-ink shadow-lg transition-transform hover:scale-110"
                  data-hero-play
                  aria-label={`Reproducir video de ${heroVideo.brand}: ${heroVideo.title}`}
                >
                  <svg viewBox="0 0 24 24" class="ml-1 size-4" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>
                </button>
              )
            }
          </div>

        </div>

        <!-- PROYECTOS (vista Redes sociales): los videos que elegí; cada uno abre su modal.
             @container: la grilla se acomoda al ancho del PANEL, no al de la pantalla -->
        <div class="more @container my-8">
          <ul class="grid grid-cols-2 gap-4 @2xl:grid-cols-4">
            {featuredVideos.map(({ video, job }) => <ProjectCard video={video} job={job} />)}
          </ul>
        </div>
      </div>
    </div>

  </Fragment>

  <!-- ============ PANEL DESIGN ============ -->
  <!-- Columna del medio: Design, igual que el botón del medio del toggle -->
  <Fragment slot="design">
    <header>
      <h2
        id="pane-design-title"
        class="font-display text-2xl leading-snug font-bold tracking-tight md:text-3xl"
      >
        Diseño
      </h2>
      <p class="mt-2 text-sm text-muted md:text-base">Logos, piezas gráficas, apps y animación</p>
    </header>

    <!-- Imagen + proyectos. @container: se acomoda al ancho del PANEL.
         Panel angosto (inicio, mobile) → uno debajo del otro.
         Panel ancho (vista de esta área en desktop) → imagen a la izquierda, proyectos a la derecha -->
    <div class="@container">
      <div class="@4xl:grid @4xl:grid-cols-[minmax(0,26rem)_1fr] @4xl:items-start @4xl:gap-12">
        <!-- IMAGEN: collage con 3 trabajos reales. El primero (destacado) ocupa las dos filas de la izquierda.
             Cada uno lleva a su proyecto en Behance -->
        <ul class="mx-auto my-5 grid w-full max-w-md grid-cols-2 grid-rows-2 gap-2.5">
          {
            designPreview.map((work, i) => (
              <li class={i === 0 ? 'row-span-2' : ''}>
                <a
                  href={work.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group block h-full overflow-hidden rounded-2xl border border-line shadow-md"
                >
                  <img
                    src={work.image}
                    alt=""
                    class={`size-full object-cover transition-transform duration-300 group-hover:scale-105 ${i === 0 ? 'aspect-[3/4]' : 'aspect-[4/3]'}`}
                  />
                  <span class="sr-only">{work.title} (Behance, se abre en otra pestaña)</span>
                </a>
              </li>
            ))
          }
        </ul>

        <!-- PROYECTOS (vista Design). Filas por categoría.
             @container: la grilla se acomoda al ancho del PANEL, no al de la pantalla.
             Panel angosto → carrusel; @sm → 2 columnas; @3xl (panel ancho) → categoría a la izquierda + 3 columnas -->
        <!-- w-full: un @container no mide su contenido; sin ancho fijo, dentro de la grilla quedaba en 0px -->
        <div class="more @container mx-auto my-8 w-full max-w-5xl text-left">
        {
          designCategories.map((category) => {
            // Trabajos de esta categoría: solo los que tienen imagen, y como mucho 2
            // (elegí mostrar poco: a la gente no le interesa ver todo). Si no hay ninguno, no se dibuja la fila
            const works = designWork.filter((work) => work.category === category && work.image).slice(0, 2);
            return (
              works.length > 0 && (
                <section
                  class="border-t border-line py-6 @3xl:grid @3xl:grid-cols-[9rem_1fr] @3xl:gap-8"
                  aria-labelledby={`design-${category}`}
                >
                  <h3 id={`design-${category}`} class="eyebrow mb-4 flex items-baseline gap-2 @3xl:mb-0">
                    {category}
                    {/* Cantidad de trabajos con dos dígitos: 2 → "02" */}
                    <span class="font-mono text-[11px]">{String(works.length).padStart(2, '0')}</span>
                  </h3>
                  {/* Dos tarjetas chicas lado a lado (max-w-lg: no se estiran en pantallas grandes) */}
                  <ul class="grid max-w-lg grid-cols-2 gap-3">
                    {works.map((work) => (
                      <li>
                        <a
                          href={work.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="bento group relative block h-full overflow-hidden transition-colors hover:border-accent"
                        >
                          {/* relative: el texto sr-only (que es absolute) queda dentro de la tarjeta;
                              sin esto se ubicaba respecto de la página y la ensanchaba en mobile */}
                          {/* Portada: imagen si hay, si no un degradé con la inicial */}
                          <div class="relative aspect-[4/3] overflow-hidden bg-linear-to-br from-accent-soft to-accent">
                            {work.image ? (
                              <img src={work.image} alt="" class="size-full object-cover transition-transform duration-300 group-hover:scale-105" />
                            ) : (
                              <span class="absolute inset-0 grid place-items-center text-5xl font-black text-accent-ink/40" aria-hidden="true">
                                {work.title.charAt(0)}
                              </span>
                            )}
                          </div>
                          <div class="flex items-start justify-between gap-3 p-3 text-left">
                            <span>
                              <span class="block font-mono text-[11px] text-muted">{work.type}</span>
                              <span class="block text-sm font-bold">{work.title}</span>
                            </span>
                            <span aria-hidden="true" class="text-lg transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                            <span class="sr-only">(se abre en otra pestaña)</span>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )
            );
          })
        }
        </div>
      </div>
    </div>

  </Fragment>

  <!-- ============ PANEL CODE ============ -->
  <Fragment slot="code">
    <header class="md:text-right">
      <h2
        id="pane-code-title"
        class="font-display text-2xl leading-snug font-bold tracking-tight md:text-3xl"
      >
        Programación
      </h2>
      <p class="mt-2 text-sm text-muted md:text-base">Páginas web que se ven bien en el celular</p>
    </header>

    <!-- @container: la grilla de proyectos se acomoda al ancho del PANEL, no al de la pantalla -->
    <div class="@container">
      <div>
        <!-- IMAGEN de la portada: un sitio mío (featured en profile.ts), inclinado en 3D en desktop (ver .tilt abajo).
             En la vista Programación se esconde (.code-cover): los cuadrados de abajo ya lo muestran -->
        {featuredSite && <BrowserCard project={featuredSite} class="tilt code-cover mx-auto my-5 w-full max-w-md" />}

        <!-- PROYECTOS (vista Programación) -->
        <div class="more my-8">
          <!-- Los que elegí mostrar, en cuadrados con la captura de cada sitio -->
          <ul class="grid gap-5 @xl:grid-cols-2 @4xl:grid-cols-3">
            {
              projects.map((project) => (
                <li>
                  <BrowserCard project={project} ratio="1/1" />
                  <p class="mt-3 text-sm font-bold">{project.title}</p>
                  <p class="text-xs text-muted">{project.type}</p>
                </li>
              ))
            }
          </ul>

          <!-- Más proyectos desde la API de GitHub (sin repetir los de arriba: exclude) -->
          <p class="eyebrow mt-10 mb-3">Más proyectos, desde mi GitHub</p>
          <DynamicApiWidget user={profile.github} exclude={projects.map((project) => project.url)} />

          <!-- Tecnologías: solo dentro de esta vista (a un cliente en la portada no le dicen nada) -->
          <p class="eyebrow mt-8">Con qué trabajo</p>
          <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tecnologías">
            {
              stack.code.map((tech) => (
                <li class="rounded-full border border-line bg-surface px-3 py-1 font-mono text-[11px] font-medium">{tech}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

  </Fragment>

  <!-- ============ SOBRE MÍ ============ -->
  <!-- Desktop: foto redonda a la izquierda y texto a la derecha, centrado en alto con la foto (items-center).
       Mobile: la foto arriba, centrada, y el texto debajo -->
  <Fragment slot="about">
    <div class="mx-auto grid max-w-5xl items-center gap-8 md:grid-cols-[auto_1fr] md:gap-12">
      <!-- Recorte redondo: aspect-square + rounded-full la vuelven un círculo,
           object-cover recorta lo que sobra y object-[50%_25%] sube el encuadre a la cara.
           width/height: el navegador reserva el lugar antes de que cargue (no "salta" el texto).
           lazy: está abajo de todo, se descarga recién cuando te acercás scrolleando -->
      <img
        src={profile.photo.src}
        alt={profile.photo.alt}
        width="1200"
        height="1600"
        loading="lazy"
        class="mx-auto aspect-square w-48 rounded-full border border-line object-cover object-[50%_25%] md:w-64"
      />
      <div>
        <h2 id="sobre-mi-title" class="font-display text-2xl font-bold tracking-tight md:text-3xl">Sobre mí</h2>
        <p class="eyebrow mt-1">{profile.location}</p>
        <div class="mt-4 max-w-prose space-y-4 leading-relaxed">
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </Fragment>

  <!-- ============ CONTACTO ============ -->
  <!-- Los datos salen de contact y socials (profile.ts). Centrado, como cierre de la página -->
  <Fragment slot="contact">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="contacto-title" class="font-display text-2xl font-bold tracking-tight md:text-3xl">¿Trabajamos juntos?</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Contenido UGC para marcas, diseño gráfico o un sitio web: escribime y lo charlamos.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <!-- mailto: abre el programa de correo con mi dirección ya puesta -->
        <a
          href={`mailto:${contact.email}`}
          class="rounded-full bg-ink px-6 py-3 text-sm font-bold text-cream transition-opacity hover:opacity-85"
        >
          {contact.email}
        </a>

        {/* WhatsApp: solo si hay número cargado. wa.me abre el chat con el mensaje ya escrito.
            encodeURIComponent convierte espacios y signos para que entren en la URL */}
        {
          contact.whatsapp && (
            <a
              href={`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bento px-6 py-3 text-sm font-bold transition-colors hover:border-accent"
            >
              WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
          )
        }
      </div>

      <ul class="mt-8 flex justify-center gap-6 text-sm text-muted">
        {
          socials.map((social) => (
            <li>
              <a class="hover:text-accent-ink" href={social.href} target="_blank" rel="noopener noreferrer">
                {social.label}<span class="sr-only"> (se abre en otra pestaña)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Fragment>

  <!-- ============ FOOTER ============ -->
  <Fragment slot="footer">
    <p class="text-center text-sm text-muted">© {new Date().getFullYear()} Renata Mandelman. Todos los derechos reservados.</p>
  </Fragment>
</SplitLayout>

<script>
  // Al tocar play en el celular: se crea el iframe de TikTok encima de todo.
  // Hasta ese momento la página no carga nada de TikTok.
  const phone = document.querySelector<HTMLElement>('[data-hero-video]');
  const playButton = phone?.querySelector<HTMLButtonElement>('[data-hero-play]');

  playButton?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = phone!.dataset.heroVideo!;
    iframe.title = phone!.dataset.heroTitle!;
    iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
    iframe.className = 'absolute inset-0 z-10 size-full border-0';
    phone!.append(iframe);
    playButton.remove();
    iframe.focus(); // el foco pasa al video para seguir con teclado
  });
</script>

<style>
  /* En la vista Programación la captura grande sobra: abajo están los cuadrados */
  :global(html[data-view='code']) :global(.code-cover) { display: none; }

  /* ---------- Ventana del navegador inclinada (solo desktop y si no se pidió menos movimiento) ---------- */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    /* :global porque .tilt se aplica a BrowserCard (otro componente): el CSS con scope no le llegaría */
    :global(.tilt) {
      transform: perspective(1200px) rotateY(-4deg) rotateX(2deg) scale(0.98);
      transform-origin: center right;
      transition: transform 0.4s var(--ease-out-soft);
    }
    :global(.tilt:hover) {
      transform: perspective(1200px) rotateY(-1deg) rotateX(1deg) scale(1);
    }
  }
</style>
