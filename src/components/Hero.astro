---
/**
 * Hero — Presentación de la portada (inspirada en una referencia de "estudio fotográfico").
 *
 * Responsabilidad: contar en una pantalla quién soy, qué hago y por dónde seguir.
 *   - "PORTFOLIO" gigante de fondo (decorativo, aria-hidden)
 *   - mi nombre (h1, link al inicio) y el año
 *   - en el centro, un abanico con 3 trabajos reales (en vez de una foto mía)
 *   - tarjeta izquierda: mi rol + frase + botón "Conocé mi trabajo"
 *   - tarjeta derecha: las 3 áreas como botones (data-go → abren esa vista del toggle)
 *   - dock de herramientas abajo
 *
 * Todo llega por props desde index.astro (que lo saca de profile.ts).
 * No guarda estado: los botones data-go los maneja el script de SplitLayout.
 */

interface Props {
  name: string;
  role: string;
  tagline: string;
  /** Áreas del toggle: id es el valor interno (content/design/code) */
  areas: { id: string; label: string }[];
  /** 3 trabajos para el abanico del centro */
  previews: { src: string; alt: string }[];
  tools: { name: string; short: string }[];
}

const { name, role, tagline, areas, previews, tools } = Astro.props;

// Colores de los tiles del dock: van rotando entre 3 combinaciones de mis tokens
const toolTones = ['bg-ink text-accent', 'bg-accent-ink text-cream', 'bg-accent text-ink'];
---

<section class="hero" data-hero aria-labelledby="hero-name">
  <!-- Palabra gigante de fondo: decorativa, los lectores de pantalla la saltean -->
  <p class="hero-word font-display" aria-hidden="true">Portfolio</p>

  <!-- Nombre a la izquierda y año a la derecha, debajo de la palabra -->
  <div class="hero-meta">
    <h1 id="hero-name" class="font-display">
      <!-- El nombre es el link para volver a la portada (data-home: lo usa el script de SplitLayout) -->
      <a href="/" data-home class="transition-colors hover:text-accent-ink">{name}</a>
    </h1>
    <span class="font-display" aria-hidden="true">{new Date().getFullYear()}</span>
  </div>

  <div class="hero-stage">
    <!-- Tarjeta izquierda: quién soy -->
    <div class="glass hero-card">
      <!-- Título con un "marco de selección" como en Figma (las esquinas son decorativas) -->
      <p class="selection"><span>{role}</span></p>
      <p class="mt-3 text-sm leading-relaxed text-ink/80">{tagline}</p>
      <a href="#trabajos" class="hero-button mt-4">Conocé mi trabajo</a>
    </div>

    <!-- Centro: abanico de trabajos reales -->
    <ul class="hero-fan" aria-label="Algunos de mis trabajos">
      {
        previews.map((preview) => (
          <li>
            <img src={preview.src} alt={preview.alt} />
          </li>
        ))
      }
    </ul>

    <!-- Tarjeta derecha: las áreas. Cada botón abre esa vista (mismo mecanismo que los rieles) -->
    <div class="glass hero-card">
      <p class="text-center text-sm font-bold">¿Qué querés ver?</p>
      <ul class="mt-3 flex flex-col gap-2">
        {
          areas.map((area, i) => (
            <li>
              <button type="button" data-go={area.id} class:list={['hero-pill', { 'is-first': i === 0 }]}>
                <span aria-hidden="true">★</span> {area.label}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Dock de herramientas (como el de la Mac). En celular se scrollea de costado -->
  <ul class="glass hero-dock" aria-label="Herramientas que uso">
    {
      tools.map((tool, i) => (
        <li>
          <span class={`tile font-display ${toolTones[i % toolTones.length]}`} aria-hidden="true">{tool.short}</span>
          <span class="tile-name">{tool.name}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* El fondo degradé ya no está acá: está en toda la página (body::before en global.css) */
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.5rem 1.5rem 2rem;
  }

  /* ---------- "PORTFOLIO" gigante ----------
     clamp: crece con el ancho de la pantalla (vw) pero con un mínimo y un máximo */
  .hero-word {
    font-size: clamp(3.5rem, 17vw, 15rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-accent-ink); /* verde petróleo: en blanco casi no se veía sobre el fondo verde agua */
    user-select: none;
  }

  /* ---------- Nombre y año ---------- */
  .hero-meta {
    display: flex;
    width: 100%;
    max-width: 72rem;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: clamp(1.1rem, 2.6vw, 2.25rem);
    font-weight: 300; /* fino, como en la referencia */
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  /* ---------- Escenario: tarjeta | abanico | tarjeta ----------
     Mobile: uno debajo del otro. Desktop: tres columnas */
  .hero-stage {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 72rem;
    margin-top: 2rem;
    justify-items: center;
  }

  /* Tarjeta "vidrio": blanco semitransparente + desenfoque de lo que hay atrás */
  .glass {
    background: color-mix(in srgb, white 65%, transparent);
    border: 1px solid color-mix(in srgb, white 80%, transparent);
    border-radius: 1.5rem;
    box-shadow: 0 20px 50px -20px rgb(24 24 27 / 0.25);
    backdrop-filter: blur(16px);
  }

  .hero-card {
    width: 100%;
    max-width: 20rem;
    padding: 1.25rem;
  }

  /* Marco de selección tipo Figma: borde + dos "manijas" redondas en las esquinas */
  .selection {
    text-align: center;
  }
  .selection span {
    position: relative;
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border: 1.5px solid var(--color-accent-ink);
    background: color-mix(in srgb, var(--color-accent) 25%, transparent);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .selection span::before,
  .selection span::after {
    content: '';
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent-ink);
  }
  .selection span::before { top: -0.3rem; left: -0.3rem; }
  .selection span::after { bottom: -0.3rem; right: -0.3rem; }

  /* Botón de la tarjeta izquierda y pastillas de la derecha */
  .hero-button,
  .hero-pill {
    display: block;
    width: 100%;
    padding: 0.6rem 1rem;
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out-soft), color 0.2s var(--ease-out-soft);
  }
  .hero-button { color: var(--color-accent-ink); }
  .hero-pill.is-first { color: var(--color-accent-ink); }
  .hero-button:hover,
  .hero-pill:hover { background: var(--color-ink); color: var(--color-cream); }

  /* ---------- Abanico de trabajos ----------
     Las 3 imágenes se apilan en la misma celda de una grilla y se rotan para abrirse en abanico */
  .hero-fan {
    display: grid;
    width: min(55vw, 17rem); /* en celular más chico, así las cartas de los costados entran */
    aspect-ratio: 3 / 4;
  }
  .hero-fan li {
    grid-area: 1 / 1; /* las tres en la misma celda */
    overflow: hidden;
    border: 4px solid white;
    border-radius: 1.25rem;
    box-shadow: 0 20px 40px -15px rgb(24 24 27 / 0.35);
    transition: transform 0.4s var(--ease-out-soft);
  }
  .hero-fan li:nth-child(1) { transform: rotate(-10deg) translateX(-18%); }
  .hero-fan li:nth-child(2) { transform: rotate(8deg) translateX(18%); }
  .hero-fan li:nth-child(3) { transform: rotate(-1deg); z-index: 1; } /* la del medio, adelante */
  .hero-fan:hover li:nth-child(1) { transform: rotate(-14deg) translateX(-26%); }
  .hero-fan:hover li:nth-child(2) { transform: rotate(12deg) translateX(26%); }
  .hero-fan img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* ---------- Dock ---------- */
  .hero-dock {
    display: flex;
    gap: 0.75rem;
    max-width: 100%;
    margin-top: 2rem;
    padding: 0.75rem 1rem;
    overflow-x: auto; /* en celular no entra: se scrollea de costado */
  }
  .hero-dock li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .tile {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 700;
    transition: transform 0.2s var(--ease-out-soft);
  }
  .hero-dock li:hover .tile { transform: translateY(-4px); } /* "salta" como en la Mac */
  .tile-name {
    font-size: 0.625rem;
    color: var(--color-ink);
    white-space: nowrap;
  }

  /* ---------- El hero "se abre" al scrollear ----------
     animation-timeline: scroll() → la animación no avanza con el tiempo sino con el scroll de la página.
     animation-range: 0 90vh → empieza arriba de todo y termina cuando bajaste casi una pantalla.
     Uso translate / rotate / opacity (propiedades sueltas): se suman al transform que ya tienen
     las cartas, así no pisan el efecto del :hover.
     @supports: solo si el navegador lo entiende (en Firefox el hero queda quieto, sin romperse).
     Y solo si la persona no pidió menos movimiento. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-word,
      .hero-card,
      .hero-fan li,
      .hero-dock {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }
      .hero-word { animation-name: word-open; }
      .hero-stage > .hero-card:first-child { animation-name: card-left; }
      .hero-stage > .hero-card:last-child { animation-name: card-right; }
      .hero-fan li:nth-child(1) { animation-name: fan-left; }
      .hero-fan li:nth-child(2) { animation-name: fan-right; }
      .hero-fan li:nth-child(3) { animation-name: fan-up; }
      .hero-dock { animation-name: dock-down; }
    }
  }

  /* Las letras se separan y se desvanecen */
  @keyframes word-open {
    to { letter-spacing: 0.12em; opacity: 0.2; }
  }
  /* Las tarjetas se van hacia los costados */
  @keyframes card-left {
    to { translate: -25% 0; opacity: 0; }
  }
  @keyframes card-right {
    to { translate: 25% 0; opacity: 0; }
  }
  /* El abanico se abre: las de los costados se separan, la del medio sube */
  @keyframes fan-left {
    to { translate: -45% 8%; rotate: -10deg; }
  }
  @keyframes fan-right {
    to { translate: 45% 8%; rotate: 10deg; }
  }
  @keyframes fan-up {
    to { translate: 0 -6%; scale: 1.05; }
  }
  /* El dock baja y se desvanece */
  @keyframes dock-down {
    to { translate: 0 40%; opacity: 0; }
  }

  /* ---------- Celular y tablet: primero lo visual ----------
     order: -1 sube el abanico arriba de las tarjetas (en el HTML está en el medio) */
  @media (max-width: 1023px) {
    .hero-fan { order: -1; margin-bottom: 1rem; }
  }

  /* ---------- Tablet: las dos tarjetas lado a lado, debajo del abanico ---------- */
  @media (min-width: 640px) and (max-width: 1023px) {
    .hero-stage { grid-template-columns: 1fr 1fr; align-items: stretch; }
    .hero-fan { grid-column: 1 / -1; } /* el abanico ocupa las dos columnas */
    .hero-card { max-width: none; }
  }

  /* ---------- Desktop: tarjetas a los costados del abanico ----------
     clamp: en una notebook chica (1024px) el abanico y las tarjetas se achican para no pisarse */
  @media (min-width: 1024px) {
    .hero { min-height: 100dvh; justify-content: center; }
    .hero-stage {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      margin-top: -1rem; /* el abanico se mete un poco debajo de la palabra */
    }
    .hero-stage > :first-child { justify-self: start; }
    .hero-stage > :last-child { justify-self: end; }
    .hero-fan { width: clamp(14rem, 21vw, 19rem); }
    .hero-card { max-width: clamp(15rem, 22vw, 20rem); }
  }
</style>
