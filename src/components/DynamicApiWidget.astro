---
/**
 * DynamicApiWidget — Lista de proyectos web: los de profile.ts + los de la API de GitHub.
 *
 * Fuente: GET https://api.github.com/users/{user}/repos (pública, sin token).
 * Qué suma: los repos que tienen el topic indicado (por defecto "portfolio")
 * y una URL en "Website" (el deploy de Vercel). Para sumar un proyecto al
 * portfolio alcanza con completar esos dos campos en GitHub.
 *
 * Los proyectos de profile.ts se ven siempre (no dependen de la API);
 * los de GitHub se agregan al final de la misma lista.
 *
 * Estados (atributo data-state, se ve uno a la vez debajo de la lista):
 *   loading → "Cargando más proyectos…"
 *   done    → la API respondió (con o sin repos nuevos): no se muestra nada
 *   error   → sin conexión, límite de la API o error de GitHub (con botón Reintentar)
 *
 * Límite: sin token, GitHub permite 60 pedidos por hora por IP.
 * Si se pasa responde 403 y mostramos un mensaje específico.
 */
import ProjectLink from './ProjectLink.astro';
import type { Project } from '../data/profile';

interface Props {
  /** Usuario de GitHub */
  user: string;
  /** Topic que marca un repo como "proyecto del portfolio" */
  topic?: string;
  /** Proyectos fijos (profile.ts): van primero y se ven aunque falle la API */
  projects?: Project[];
}

const { user, topic = 'portfolio', projects = [] } = Astro.props;
---

<!-- Los datos van en data-*: el script corre en el navegador y no ve las variables de arriba -->
<div data-github-widget data-user={user} data-topic={topic} aria-busy="true">
  <ul class="grid gap-2" aria-label="Proyectos web" data-list>
    {projects.map((project) => <ProjectLink url={project.url} type={project.type} title={project.title} />)}
  </ul>

  <!-- aria-live: los lectores de pantalla anuncian cuando cambia el estado -->
  <div aria-live="polite">
    <p data-state="loading" class="mt-3 text-xs text-muted">Cargando más proyectos…</p>

    <div data-state="error" class="mt-3 flex flex-wrap items-center gap-3 text-xs text-muted md:justify-end" hidden>
      <p data-error-message>No se pudieron cargar más proyectos.</p>
      <button type="button" data-retry class="bento px-3 py-1 font-mono uppercase hover:border-accent">
        Reintentar
      </button>
    </div>
  </div>

  <!-- Molde de cada tarjeta: la misma ProjectLink, vacía. El script la copia una vez por repo -->
  <template data-item>
    <ProjectLink />
  </template>
</div>

<script>
  // Solo los campos de la respuesta de GitHub que usamos
  type Repo = {
    name: string;
    description: string | null;
    homepage: string | null;
    topics: string[];
  };

  function initWidget(widget: HTMLElement) {
    const { user, topic } = widget.dataset;
    const list = widget.querySelector<HTMLUListElement>('[data-list]')!;
    const template = widget.querySelector<HTMLTemplateElement>('template[data-item]')!;
    const errorMessage = widget.querySelector<HTMLElement>('[data-error-message]')!;

    // Dominios de los proyectos fijos, para no repetirlos si también están en GitHub
    const fixedHosts = [...list.querySelectorAll('a')].map((a) => new URL(a.href).hostname);

    // Muestra un solo estado y oculta los demás ("done" no tiene elemento: oculta todos)
    const show = (state: 'loading' | 'done' | 'error') => {
      widget.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => {
        el.hidden = el.dataset.state !== state;
      });
      widget.setAttribute('aria-busy', String(state === 'loading'));
    };

    const showError = (message: string) => {
      errorMessage.textContent = message;
      show('error');
    };

    // Arma una tarjeta a partir del molde
    const createItem = (repo: Repo) => {
      const item = template.content.cloneNode(true) as DocumentFragment;
      const field = (name: string) => item.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
      item.querySelector('a')!.href = repo.homepage!;
      field('type').textContent = repo.description ?? 'Proyecto web';
      // "castingFlow_backend" → "castingFlow backend"
      field('title').textContent = repo.name.replaceAll(/[-_]/g, ' ');
      field('host').textContent = new URL(repo.homepage!).hostname;
      return item;
    };

    async function load() {
      show('loading');

      // Si no hay conexión, fetch "rechaza": lo convertimos en null
      const response = await fetch(`https://api.github.com/users/${user}/repos?per_page=100&sort=updated`).catch(
        () => null,
      );
      if (!response) return showError('No se pudieron cargar más proyectos: revisá tu conexión.');
      if (response.status === 403) return showError('GitHub limita los pedidos (60 por hora). Probá de nuevo en un rato.');
      if (!response.ok) return showError(`No se pudieron cargar más proyectos (error ${response.status}).`);

      const repos: Repo[] = await response.json();
      // Repos marcados con el topic, con sitio publicado y que no estén ya en la lista
      const selected = repos.filter(
        (repo) =>
          repo.homepage &&
          URL.canParse(repo.homepage) && // descarta URLs mal escritas (ej: sin https://)
          repo.topics.includes(topic!) &&
          !fixedHosts.includes(new URL(repo.homepage).hostname),
      );

      // append: se suman al final, después de los proyectos fijos
      list.append(...selected.map(createItem));
      show('done');
    }

    widget.querySelector('[data-retry]')!.addEventListener('click', load);
    load();
  }

  document.querySelectorAll<HTMLElement>('[data-github-widget]').forEach(initWidget);
</script>
