---
/**
 * ProjectCard — Tarjeta de un video elegido + modal con el video y el contexto del trabajo.
 *
 * Responsabilidad: mostrar la pieza como un botón (portada vertical, marca y título) y,
 * al tocarlo, abrir un <dialog> con el video y para quién lo hice (empresa, puesto, tareas).
 * Solo se usan los videos con featured: true en profile.ts: a la gente no le interesa ver todo.
 *
 * Por qué <dialog>:
 *   - showModal() bloquea el resto de la página y mueve el foco adentro.
 *   - Esc lo cierra solo, y al cerrar el foco vuelve al botón que lo abrió.
 *
 * Videos de TikTok / Instagram: son <iframe> con data-src en vez de src.
 * El script les pone el src recién al abrir el modal → la página no carga
 * nada de TikTok ni Instagram hasta que alguien quiere ver el video.
 */
import type { Experience, Video } from '../data/profile';
import { embedUrl } from '../utils/embed';

interface Props {
  video: Video;
  /** El trabajo al que pertenece el video (para el contexto del modal) */
  job: Experience;
}

const { video, job } = Astro.props;
const dialogId = `dialog-${video.src.replace(/[^a-zA-Z0-9]/g, '')}`; // id válido aunque src sea una ruta
---

<li>
  <button type="button" class="card" data-open={dialogId} aria-haspopup="dialog">
    <!-- Portada vertical: la imagen si hay, si no un degradé con la inicial de la marca -->
    <span class="thumb" aria-hidden="true">
      {video.poster ? <img src={video.poster} alt="" /> : <span class="initial font-display">{video.brand.charAt(0)}</span>}
      <span class="play">▶</span>
    </span>
    <span class="mt-2 block text-sm leading-tight font-bold">{video.brand}</span>
    <span class="block text-xs text-muted">{video.title}</span>
  </button>

  <dialog id={dialogId} class="dialog" aria-labelledby={`${dialogId}-title`}>
    <!-- La caja interna lleva el padding: así un clic en el fondo "cae" en el <dialog> y lo cerramos -->
    <div class="grid gap-6 p-6 md:grid-cols-[minmax(0,20rem)_1fr] md:p-8">
      {
        video.platform === 'local' ? (
          <video class="media" src={video.src} poster={video.poster} controls playsinline preload="none" />
        ) : (
          <iframe
            class="media"
            data-src={embedUrl(video)}
            title={`${video.brand}: ${video.title}`}
            allow="encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
          />
        )
      }

      <div>
        <header class="flex items-start justify-between gap-4">
          <div>
            <h3 id={`${dialogId}-title`} class="font-display text-2xl font-bold tracking-tight">{video.brand}</h3>
            <p class="text-sm text-muted">{video.title}</p>
          </div>
          <!-- method="dialog": el formulario cierra el modal sin JavaScript -->
          <form method="dialog">
            <button class="close" aria-label="Cerrar">✕</button>
          </form>
        </header>

        <!-- Contexto: para quién y qué hice -->
        <p class="mt-6 text-sm"><span class="font-bold">{job.company}</span> · {job.role}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          {job.tasks.map((task) => <li>{task}</li>)}
        </ul>
      </div>
    </div>
  </dialog>
</li>

<style>
  .card {
    display: block;
    width: 100%;
    text-align: left;
    cursor: pointer;
  }

  /* Portada en formato vertical (9:16), como se ve en el celular */
  .thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-bento);
    background: linear-gradient(160deg, var(--color-accent-soft), var(--color-accent));
    transition: transform 0.25s var(--ease-out-soft), box-shadow 0.25s var(--ease-out-soft);
  }
  .card:hover .thumb { transform: translateY(-3px); box-shadow: 0 16px 30px -18px rgb(24 24 27 / 0.45); }
  .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .initial { font-size: 3rem; font-weight: 800; color: var(--color-accent-ink); }

  /* Botón de play decorativo en el centro de la portada */
  .play {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding-left: 0.2rem;
    border-radius: 50%;
    background: color-mix(in srgb, white 90%, transparent);
    color: var(--color-ink);
    font-size: 0.9rem;
  }

  .dialog {
    width: min(100% - 2rem, 52rem);
    max-height: 90dvh;
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-bento);
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .dialog::backdrop {
    background: color-mix(in srgb, var(--color-ink) 60%, transparent);
    backdrop-filter: blur(4px);
  }

  .close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    cursor: pointer;
  }
  .close:hover { border-color: var(--color-ink); }

  /* Video o iframe en formato vertical (9:16) */
  .media {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border: 0;
    border-radius: 0.75rem;
    background: var(--color-ink);
  }

  /* Con un modal abierto, la página de atrás no scrollea */
  :global(html:has(dialog[open])) { overflow: hidden; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.open!) as HTMLDialogElement;
    const iframes = dialog.querySelectorAll<HTMLIFrameElement>('iframe[data-src]');

    button.addEventListener('click', () => {
      // Recién ahora cargamos el reproductor de TikTok / Instagram
      iframes.forEach((iframe) => { iframe.src = iframe.dataset.src!; });
      dialog.showModal();
    });

    dialog.addEventListener('close', () => {
      // Al cerrar, frenamos todo: pausamos el .mp4 y descargamos el iframe
      dialog.querySelectorAll('video').forEach((video) => video.pause());
      iframes.forEach((iframe) => iframe.removeAttribute('src'));
    });

    // Clic afuera de la caja (en el fondo oscuro) → cerrar
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
