---
/**
 * ProjectCard — Tarjeta de una experiencia + modal "Case Study".
 *
 * Responsabilidad: mostrar la marca como un botón y, al tocarlo, abrir un
 * <dialog> con el puesto, las tareas y (si tiene) los videos.
 *
 * Por qué <dialog>:
 *   - showModal() bloquea el resto de la página y mueve el foco adentro.
 *   - Esc lo cierra solo, y al cerrar el foco vuelve al botón que lo abrió.
 *
 * Videos de TikTok / Instagram: son <iframe> con data-src en vez de src.
 * El script les pone el src recién al abrir el modal → la página no carga
 * nada de TikTok ni Instagram hasta que alguien quiere ver los videos.
 */
import type { Experience } from '../data/profile';
import { embedUrl } from '../utils/embed';

interface Props {
  job: Experience;
}

const { job } = Astro.props;
const dialogId = `dialog-${job.id}`;
---

<li>
  <button type="button" class="card bento" data-open={dialogId} aria-haspopup="dialog">
    <span
      class="flex size-9 items-center justify-center rounded-full bg-accent-soft text-sm font-bold text-accent-ink"
      aria-hidden="true"
    >
      {job.company.charAt(0)}
    </span>
    <span class="text-xs leading-tight font-bold">{job.company}</span>
    {job.videos && <span class="font-mono text-[10px] text-muted">{job.videos.length} videos</span>}
  </button>

  <dialog id={dialogId} class="dialog" aria-labelledby={`${dialogId}-title`}>
    <!-- La caja interna lleva el padding: así un clic en el fondo "cae" en el <dialog> y lo cerramos -->
    <div class="p-6 md:p-8">
      <header class="flex items-start justify-between gap-4">
        <div>
          <p class="font-mono text-xs text-muted">{job.period}</p>
          <h3 id={`${dialogId}-title`} class="mt-1 text-2xl font-extrabold tracking-tight uppercase">{job.company}</h3>
          <p class="text-sm text-muted">{job.role}</p>
        </div>
        <!-- method="dialog": el formulario cierra el modal sin JavaScript -->
        <form method="dialog">
          <button class="close" aria-label="Cerrar">✕</button>
        </form>
      </header>

      <ul class="mt-5 list-disc space-y-1 pl-5 text-sm">
        {job.tasks.map((task) => <li>{task}</li>)}
      </ul>

      <ul class="mt-4 flex flex-wrap gap-1.5">
        {job.stack.map((tool) => <li class="rounded-full bg-accent-soft px-2.5 py-1 text-xs">{tool}</li>)}
      </ul>

      {
        job.videos && (
          <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {job.videos.map((video) => (
              <li>
                <figure>
                  {video.platform === 'local' ? (
                    <video
                      class="media"
                      src={video.src}
                      poster={video.poster}
                      controls
                      playsinline
                      preload="none"
                    />
                  ) : (
                    <iframe
                      class="media"
                      data-src={embedUrl(video)}
                      title={`${video.brand}: ${video.title}`}
                      allow="encrypted-media; fullscreen; picture-in-picture"
                      loading="lazy"
                    />
                  )}
                  <figcaption class="mt-2 text-sm">
                    <span class="font-bold">{video.brand}</span>
                    <span class="text-muted"> · {video.title}</span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </dialog>
</li>

<style>
  .card {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s var(--ease-out-soft);
  }
  .card:hover { border-color: var(--color-accent); transform: translateY(-2px); }

  .dialog {
    width: min(100% - 2rem, 64rem);
    max-height: 90dvh;
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-bento);
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .dialog::backdrop {
    background: color-mix(in srgb, var(--color-ink) 60%, transparent);
    backdrop-filter: blur(4px);
  }

  .close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    cursor: pointer;
  }
  .close:hover { border-color: var(--color-ink); }

  /* Videos e iframes en formato vertical (9:16), como se ven en el celular */
  .media {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border: 0;
    border-radius: 0.75rem;
    background: var(--color-ink);
  }

  /* Con un modal abierto, la página de atrás no scrollea */
  :global(html:has(dialog[open])) { overflow: hidden; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.open!) as HTMLDialogElement;
    const iframes = dialog.querySelectorAll<HTMLIFrameElement>('iframe[data-src]');

    button.addEventListener('click', () => {
      // Recién ahora cargamos los reproductores de TikTok / Instagram
      iframes.forEach((iframe) => { iframe.src = iframe.dataset.src!; });
      dialog.showModal();
    });

    dialog.addEventListener('close', () => {
      // Al cerrar, frenamos todo: pausamos los .mp4 y descargamos los iframes
      dialog.querySelectorAll('video').forEach((video) => video.pause());
      iframes.forEach((iframe) => iframe.removeAttribute('src'));
    });

    // Clic afuera de la caja (en el fondo oscuro) → cerrar
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
