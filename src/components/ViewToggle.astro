---
/**
 * ViewToggle — Segmented control [ REDES SOCIALES ⇄ DISEÑO ⇄ PROGRAMACIÓN ]
 *
 * Responsabilidad: definir el MODO DE LECTURA de toda la experiencia.
 *   - "content" → Redes sociales (videos y contenido)
 *   - "design"  → Diseño (gráfico, apps y webs, motion)
 *   - "code"    → Programación (páginas web)
 * Al entrar, <html data-view="all"> (las tres columnas) y no hay ninguna opción marcada:
 * la pastilla aparece recién cuando se elige una.
 * Las flechas ⇄ son decorativas (aria-hidden): solo separan las opciones.
 *
 * Cómo funciona:
 *   1. Son <input type="radio"> nativos → accesibles por defecto
 *      (Tab para entrar, flechas ← → para cambiar, lectores de pantalla los anuncian).
 *   2. Al cambiar, se escribe el estado en <html data-view="...">.
 *      El CSS de SplitLayout reacciona a ese atributo (una sola fuente de verdad).
 *   3. Se guarda en localStorage para recordar la preferencia.
 *   4. Se emite el evento "viewchange" para que otros componentes puedan escuchar.
 *   5. Los botones [data-show-all] vuelven a la portada: desmarca los radios y escribe "all".
 */

type View = 'content' | 'design' | 'code';

interface Props {
  /** Opción marcada al cargar (por defecto ninguna: la vista inicial es "all") */
  initial?: View;
  /** id único por si se usa más de un toggle en la página */
  id?: string;
}

const { initial, id = 'view-toggle' } = Astro.props;

const options: { value: View; label: string; srLabel: string }[] = [
  // value: nombre interno del estado (no cambia). label: lo que lee la gente
  { value: 'content', label: 'Redes sociales', srLabel: 'Ver mis videos para redes sociales' },
  { value: 'design', label: 'Diseño', srLabel: 'Ver mis diseños' },
  { value: 'code', label: 'Programación', srLabel: 'Ver mis páginas web' },
];
---

<fieldset class="view-toggle" id={id} data-view-toggle>
  <legend class="sr-only">Modo de lectura del portfolio</legend>

  <span class="bracket" aria-hidden="true">[</span>

  <div class="track">
    <!-- "Pastilla" que se desliza detrás de la opción activa -->
    <span class="thumb" aria-hidden="true"></span>

    {
      options.map((opt, i) => (
        <>
        {/* Flecha decorativa entre opciones (no antes de la primera) */}
        {i > 0 && <span class="arrow" aria-hidden="true">⇄</span>}
        <label class="option" data-option={opt.value}>
          <input
            type="radio"
            name={`${id}-view`}
            value={opt.value}
            checked={opt.value === initial}
            class="sr-only"
          />
          <span aria-hidden="true">{opt.label}</span>
          <span class="sr-only">{opt.srLabel}</span>
        </label>
        </>
      ))
    }
  </div>

  <span class="bracket" aria-hidden="true">]</span>

  <!-- Anuncia el cambio a lectores de pantalla -->
  <p class="sr-only" aria-live="polite" data-view-status></p>
</fieldset>

<style>
  .view-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 8px 24px -12px rgb(24 24 27 / 0.18);
  }

  .bracket,
  .arrow { color: var(--color-muted); }
  .arrow { padding-inline: 0.15rem; }

  /* Celular: "Redes sociales" y "Programación" son largas. Para que el toggle entre en una línea
     escondo los corchetes y flechas (son decorativos) y achico un poco el texto */
  @media (max-width: 480px) {
    .view-toggle { gap: 0; padding: 0.3rem; font-size: 0.75rem; letter-spacing: 0.04em; }
    .bracket,
    .arrow { display: none; }
    .option { padding: 0.4rem 0.6rem; }
  }

  .track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, auto); /* 3 opciones + 2 flechas */
    align-items: center;
  }

  .option {
    position: relative;
    z-index: 1;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    cursor: pointer;
    text-align: center;
    transition: color 0.25s var(--ease-out-soft);
    user-select: none;
    white-space: nowrap; /* "Redes sociales" en un solo renglón */
  }
  .option:hover { color: var(--color-ink); }

  /* Opción activa: texto oscuro sobre la pastilla */
  .option:has(input:checked) { color: var(--color-ink); font-weight: 500; }

  /* Foco por teclado: el input está oculto, así que el anillo va en el label */
  .option:has(input:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* ---------- Portada (data-view="all"): que se entienda que hay que tocarlo ----------
     No hay ninguna opción marcada, así que sin esto el toggle parece un subtítulo. */

  /* 1. Cada opción se ve como un botón: fondo suave y texto oscuro */
  :global(html[data-view='all']) .option {
    background: var(--color-accent-soft);
    color: var(--color-ink);
    transition: background-color 0.25s var(--ease-out-soft);
  }
  :global(html[data-view='all']) .option:hover { background: var(--color-accent); }

  /* 2. Invitación: las opciones se iluminan una tras otra, dos veces, y se quedan quietas.
     Solo si la persona no pidió "reducir movimiento" en su sistema */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-view='all']) .option {
      animation: invite 1.2s var(--ease-out-soft) 2;
    }
    /* Cada opción arranca un poco después que la anterior: Content → Design → Code */
    :global(html[data-view='all']) .option[data-option='design'] { animation-delay: 0.2s; }
    :global(html[data-view='all']) .option[data-option='code'] { animation-delay: 0.4s; }
  }

  @keyframes invite {
    0%, 100% { background: var(--color-accent-soft); }
    30% { background: var(--color-accent); }
  }

  /* Pastilla deslizante: se posiciona con variables que setea el script */
  .thumb {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--thumb-x, 0px);
    width: var(--thumb-w, 0px);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    transition:
      left 0.35s var(--ease-out-soft),
      width 0.35s var(--ease-out-soft);
  }
</style>

<script>
  type View = 'content' | 'design' | 'code';

  const STORAGE_KEY = 'rm-view';
  const MESSAGES: Record<View, string> = {
    content: 'Vista: redes sociales',
    design: 'Vista: diseño',
    code: 'Vista: programación',
  };

  // 'all' = la portada con las tres áreas (ningún radio marcado)
  function setView(view: View | 'all') {
    const root = document.documentElement;
    if (root.dataset.view === view) return;

    const apply = () => {
      root.dataset.view = view;
    };

    // View Transitions API: anima el cambio de layout si el navegador lo soporta.
    // Si no (o si el usuario prefiere menos movimiento), cambia directo.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if ('startViewTransition' in document && !reduceMotion) {
      document.startViewTransition(apply);
    } else {
      apply();
    }

    // En la portada no guardamos nada: así al recargar también se ve la portada
    try {
      if (view === 'all') localStorage.removeItem(STORAGE_KEY);
      else localStorage.setItem(STORAGE_KEY, view);
    } catch (_) {}
    document.dispatchEvent(new CustomEvent('viewchange', { detail: { view } }));
  }

  function initToggle(toggle: HTMLElement) {
    const thumb = toggle.querySelector<HTMLElement>('.thumb')!;
    const status = toggle.querySelector<HTMLElement>('[data-view-status]')!;
    const inputs = toggle.querySelectorAll<HTMLInputElement>('input[type="radio"]');

    // Mueve la pastilla debajo de la opción marcada
    const moveThumb = () => {
      const checked = toggle.querySelector<HTMLInputElement>('input:checked');
      const label = checked?.closest<HTMLElement>('.option');
      // Ninguno marcado (portada): la pastilla se achica a 0 y no se ve
      if (!label) {
        thumb.style.setProperty('--thumb-w', '0px');
        return;
      }
      thumb.style.setProperty('--thumb-x', `${label.offsetLeft}px`);
      thumb.style.setProperty('--thumb-w', `${label.offsetWidth}px`);
    };

    // Sincroniza el radio con la vista actual (la que restauró BaseLayout).
    // Si es "all" ningún radio coincide: quedan todos sin marcar y la pastilla no se ve.
    const current = document.documentElement.dataset.view;
    inputs.forEach((input) => { input.checked = input.value === current; });
    moveThumb();

    inputs.forEach((input) => {
      input.addEventListener('change', () => {
        const view = input.value as View;
        setView(view);
        moveThumb();
        status.textContent = MESSAGES[view];
      });
    });

    // Botones "Ver las tres áreas" (data-show-all): vuelven a la portada.
    // Viven en SplitLayout, pero el que cambia el estado es este componente (única fuente de verdad)
    document.querySelectorAll<HTMLButtonElement>('[data-show-all]').forEach((button) => {
      button.addEventListener('click', () => {
        inputs.forEach((input) => { input.checked = false; });
        setView('all');
        moveThumb();
        status.textContent = 'Vista: las tres áreas';
      });
    });

    // Si cambia el tamaño (ej: rotar el celular), recalcula la pastilla
    new ResizeObserver(moveThumb).observe(toggle);

    // Cuando terminan de cargar las fuentes cambian los anchos de los labels:
    // hay que volver a medir (si no, la pastilla queda corrida)
    document.fonts.ready.then(moveThumb);
  }

  document.querySelectorAll<HTMLElement>('[data-view-toggle]').forEach(initToggle);
</script>
